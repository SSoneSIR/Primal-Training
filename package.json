{
	"name": "primal-training",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"setup": "node ./scripts/setup.mjs",
		"repo:doctor": "node ./scripts/doctor.mjs",
		"check": "biome check --write .",
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F client dev",
		"dev:server": "turbo -F api dev",
		"db:push": "turbo -F @primal-training/db db:push",
		"db:studio": "turbo -F @primal-training/db db:studio",
		"db:generate": "turbo -F @primal-training/db db:generate",
		"db:migrate": "turbo -F @primal-training/db db:migrate",
		"db:seed": "turbo -F @primal-training/db db:seed",
		"db:start": "turbo -F @primal-training/db db:start",
		"db:watch": "turbo -F @primal-training/db db:watch",
		"db:stop": "turbo -F @primal-training/db db:stop",
		"db:down": "turbo -F @primal-training/db db:down"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/node": "^22.13.11",
		"tsdown": "^0.15.5",
		"turbo": "^2.5.4",
		"typescript": "^5.8.2"
	},
	"packageManager": "pnpm@10.24.0"
}
